                        <font class="pos_2" ng-show="item.CURRENT_STATE == 0">OFF</font><font class="current-state-time__text pos_3" ng-show="item.CURRENT_STATE == 0">{{item.TIME_SHIFT_OFF | secondtotime}}</font>
                    </div>

