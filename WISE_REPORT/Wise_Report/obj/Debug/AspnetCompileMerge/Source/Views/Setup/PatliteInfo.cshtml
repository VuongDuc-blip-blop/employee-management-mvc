</style>
<style>
    .machine-name__text {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-weight: bold;
        font-size: 3.5vmin;
        text-align: center;
        white-space: nowrap;
        height: 11%;
    }

    .info-machine__card-panel {
        background: rgba(0,0,0, 0.3);
        border-radius: 10px;
        overflow: hidden;
        height: 89%;
    }

    .current-state__panel {
        display: flex;
        align-items: center;
        font-size: 2.4vmin;
        font-weight: bold;
        height: 10%;
        padding: 0px 10px 0px 10px;
    }

    .uptime-progress__panel {
        padding-top: 5%;
        height: 32%;
    }

    .information-time__panel {
        display: flex;
        font-size: 2.2vmin;
        width: 100%;
        padding: 0px 10px 0px 10px;
        line-height: 3.4vmin;
        height: 9%;
        white-space: nowrap;
    }

    .current-state-time__text {
        flex: 1;
        text-align: right;
        white-space: nowrap;
    }

    .uptime-percentage__panel {
        display: flex;
        justify-content: center;
        height: 50%;
    }

    .Availability__text {
        text-align: center;
        font-size: 2vmin;
        color: rgba(255, 255, 255, 0.3);
        height: 28%;
    }

    .uptime-progress-bar__panel {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 5px;
    }

    .uptime-progress__bar {
        width: 50%;
        background: grey;
        height: 100%;
        border-radius: 9px;
        overflow: hidden;
    }

    .uptime-progress__width {
        background: rgba(1, 150, 240, 0.8);
        color: black;
        height: 100%;
    }

    .information__text {
        text-transform: capitalize;
        color: rgba(255, 255, 255, 0.5);
    }

    .information-time__text {
        flex: 1;
        text-align: right;
        color: #ffffff;
    }

    .uptime-percentage-number__text {
        font-size: 5.5vmin;
        line-height: 5.5vmin;
        color: #ffffff;
        font-weight: bold;
    }

    .uptime-percentage__text {
        font-size: 2vmin;
        line-height: 2vmin;
        color: rgba(255, 255, 255, 0.4);
        padding: 3% 0px 0px 1%;
    }

    .unit-info__text {
        height: 100%;
        font-size: 2.2vmin;
        color: rgba(255, 255, 255, 0.3);
    }
</style>
<style>
    .progress .progress-bar {
        transition: unset;
    }
</style>
<div ng-app="myApp" ng-controller="SetupPatliteCtrl">
    <div class="row">
        <div class="col-md-12">
            <div class="header-navbar" style="display:flex;justify-content:space-between;background: #222d32;">
                <header class="navbar-custom-menu " style="text-align:center;color:white;display:flex;flex:1;margin-left:15px">
                    <h3 style="margin:0;line-height:70px;text-transform:uppercase">MACHINE INFO</h3>
                </header>
                <div class="main-header" style="display:inline-block">

                    Logo
                    <a href="/Home/HomeLayout" class="logo" style="background-color:#222d32">
                        <span class="logo-mini" style="transform: translateY(10px);">
                            <img src="/Content/images/logo_hoplong.png" height="60" width="100" style="vertical-align:middle" />
                        </span>
                        <span class="logo-lg" style="transform: translateY(10px);">
                            <img src="/Content/images/logo_hoplong.png" height="60" width="100" style="position:relative;top:10px" />
                        </span>
                    </a>
                </div>

                <div class="date-time" style="line-height:70px">
                    <span id="dotter" style="margin-right:5px;top:5px;position:relative"><i class="fa fa-circle" style="color:red;font-size:25px"></i></span>
                    <span id="date"></span> &nbsp;
                    <span id='time'></span>
                    <script>
                        window.onload = setInterval(clock, 1000);
                        function clock() {
                            var d = new Date();

                            var date = d.getDate();

                            var month = d.getMonth();
                            var montharr = ["Jan", "Feb", "Mar", "April", "May", "June", "July", "Aug", "Sep", "Oct", "Nov", "Dec"];
                            month = montharr[month];

                            var year = d.getFullYear();

                            var day = d.getDay();
                            var dayarr = ["Sun", "Mon", "Tues", "Wed", "Thurs", "Fri", "Sat"];
                            day = dayarr[day];

                            var hour = d.getHours();
                            var min = d.getMinutes();
                            var sec = d.getSeconds()

                            hour = (hour < 10) ? "0" + hour : hour;
                            min = (min < 10) ? "0" + min : min;
                            sec = (sec < 10) ? "0" + sec : sec;
                            document.getElementById("date").innerHTML = day + " " + date + " " + month + " " + year;
                            document.getElementById("time").innerHTML = hour + ":" + min + ":" + sec;
                        }
                        $(document).ready(function () {
                            var dotterFlicker = document.getElementById('dotter');
                            setInterval(function () {
                                dotterFlicker.style.display = (dotterFlicker.style.display == 'none' ? '' : 'none');
                            }, 1000);

                        });
                    </script>
                </div>
                <div class="back-homepage" style="margin:0 15px;line-height:70px">
                    <a href="/Home/HomeLayout"><i class="fa fa-th-list" style="color:#fff;font-size:22px;top:4px;position:relative"></i></a>
                </div>

            </div>
        </div>
    </div>
    <table class="table">
        <tr>
            <th>Mã đèn</th>
            <th>Tên</th>
            <th>Miêu tả</th>
            <th>% Đánh giá</th>
            <th>Tác vụ</th>
        </tr>
        <tr>
            <th>
                <input ng-model="tukhoa1" class="form-control" ng-change="TimKiem()" ng-model-options="{debounce:700}"/>
            </th>
            <th>
                <input ng-model="tukhoa2" class="form-control" ng-change="TimKiem()" ng-model-options="{debounce:700}" />
            </th>
            <th>
                <input ng-model="tukhoa3" class="form-control" ng-change="TimKiem()" ng-model-options="{debounce:700}" />
            </th>
            <th></th>
            <th></th>
        </tr>
        <tr ng-repeat="item in ListPatlite">
            <td style="vertical-align:middle">{{item.WDT_MAC_ADDRESS}}</td>
            <td style="vertical-align:middle">
                <p ng-hide="hienthi">{{item.WDT_USERNAME}}</p>
                <input ng-show="hienthi" ng-model="item.WDT_USERNAME" class="form-control" />
            </td>
            <td style="vertical-align:middle">
                <p ng-hide="hienthi">{{item.DESCRIPTION}}</p>
                <input ng-show="hienthi" ng-model="item.DESCRIPTION" class="form-control" />
            </td>
            <td style="vertical-align:middle">
                <p ng-hide="hienthi">{{item.PERCENT_TARGET}}%</p>
                <input ng-show="hienthi" type="number" ng-model="item.PERCENT_TARGET" class="form-control" />
            </td>
            <td style="vertical-align:middle" class="text-center">
                <button class="btn" ng-hide="hienthi" ng-click="hienthi=true">Sửa</button>
                <button class="btn" ng-show="hienthi" ng-click="hienthi=false;EditPatlite(item)">Lưu</button>
                <button class="btn" ng-show="hienthi" ng-click="hienthi=false">Hủy</button>
            </td>
        </tr>
    </table>
    <div class="col-md-12 text-center">
        <div id="phan_trang"></div>
    </div>
</div>