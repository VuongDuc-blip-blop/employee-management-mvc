<script src="~/Content/js/SetupPatliteCtrl.js?time=@DateTime.Now"></script>
<link href="~/Content/css/HomeCSS.css" rel="stylesheet" />
<link href="~/Content/css/kho.css" rel="stylesheet" />
<style>
    table tr td{
        background-color:white
    }
</style>
<style>
    .progress {
        background-color: black !important;
    }

    .green {
        background-color: rgb(0, 193, 9);
        color: white;
    }

    .red {
        background-color: red;
        color: white;
    }

    .yellow {
        background-color: yellow;
        color: black;
    }

    .yellow-orange {
        background-color: #F9A200;
    }

    .BLUE {
        background-color: blue;
        color: white;
    }

    .ORANGE {
        background-color: orange;
        color: white;
    }

    .OFF {
        background-color: grey;
        color: white;
    }

    td {
        /*border-top: 10px solid black !important;*/
        padding: 0px !important;
    }

    .ten {
        width: 16%;
        display: inline-block;
    }

    .main_font {
        font-size: 22px;
    }

    .sub_font {
        font-size: 14px;
    }

    @@media screen and (max-width: 1600px) {
        .main_font {
            font-size: 18px;
        }

        .sub_font {
            font-size: 12px;
        }
    }

    @@media screen and (max-width: 1366px) {
        .main_font {
            font-size: 14px;
        }

        .sub_font {
            font-size: 11px;
        }
    }

    @@media screen and (max-width: 1280px) {
        .main_font {
            font-size: 14px;
        }

        .sub_font {
            font-size: 10px;
        }
    }

    @@media screen and (max-width: 1024px) {
        .main_font {
            font-size: 11px;
        }

        .sub_font {
            font-size: 8px;
        }
