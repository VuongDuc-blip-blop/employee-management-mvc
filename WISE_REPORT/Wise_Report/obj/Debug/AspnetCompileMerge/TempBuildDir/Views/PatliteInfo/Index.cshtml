                    <th class="text-center" style="width:10%">UPTIME(%)</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in ListPatlite">
                    <td>
                        <div class="progress" style="position:relative;color:white;text-align:center"
