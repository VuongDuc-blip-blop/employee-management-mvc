<style>
    .pagination {
        margin: 0px !important;
    }

    .table > tbody > tr > td {
        padding: 1px !important;
    }

    tr:hover {
        background-color: #71cbf3;
    }
</style>
<style>
    .switch {
        position: relative;
        display: inline-block;
        width: 30%;
        height: 34px;
        margin: 3px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        -webkit-transition: .4s;
        transition: .4s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            -webkit-transition: .4s;
            transition: .4s;
        }

    input:checked + .green {
        background-color: green;
    }

    input:focus + .green {
        box-shadow: 0 0 1px green;
    }

    input:checked + .orange {
        background-color: yellow;
    }

    input:focus + .orange {
        box-shadow: 0 0 1px yellow;
    }

    input:checked + .red {
        background-color: red;
    }

    input:focus + .red {
        box-shadow: 0 0 1px red;
    }

    input:checked + .slider:before {
        -webkit-transform: translateX(26px);
        -ms-transform: translateX(26px);
        transform: translateX(26px);
    }

    /* Rounded sliders */
    .slider.round {
        border-radius: 34px;
    }

        .slider.round:before {
            border-radius: 50%;
        }

    button {
        background-color: white;
        color: deepskyblue;
    }

    .skyblue {
        background-color: deepskyblue !important;
        color: white !important;
    }
</style>