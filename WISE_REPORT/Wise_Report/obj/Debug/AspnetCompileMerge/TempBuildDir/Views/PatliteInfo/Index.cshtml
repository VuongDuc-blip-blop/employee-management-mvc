                             || (item.GREEN_LIGHT_CURRENT == 0 && item.AMBER_LIGHT_CURRENT == 0 && item.RED_LIGHT_CURRENT == 0) && {'background-color':'grey'}">
                            {{item.MAC_ADDRESS}}
                        </div>
                    </td>
                    <td class="text-center">{{item.WDT_USERNAME}}</td>
                    <td class="text-center">
                        <p>{{item.SO_LAN_GREEN}}</p>
                        <p>{{item.TONG_THOI_GIAN_GREEN}}</p>
                    </td>
                    <td class="text-center">
                        <p>{{item.SO_LAN_RED}}</p>
                        <p>{{item.TONG_THOI_GIAN_RED}}</p>
                    </td>
                    <td class="text-center">
                        <p>{{item.SO_LAN_AMBER}}</p>
                        <p>{{item.TONG_THOI_GIAN_AMBER}}</p>
                    </td>
                    <td class="text-center">
                        <p>{{item.SO_LAN_OFF}}</p>
                        <p>{{item.TONG_THOI_GIAN_OFF}}</p>
                    </td>
                    @*<td class="text-center">
                        {{item.TONG_SO_SAN_PHAM}}
                    </td>*@
                    <td>
                        <div class="progress" style="background-color:grey">
                            <div class="progress-bar progress-bar-success" role="progressbar" style="width:{{item.PhanTramTimeGreen}}%">

                            </div>
                            <div class="progress-bar progress-bar-warning" role="progressbar" style="width:{{item.PhanTramTimeAmber}}%;background-color:yellow">

                            </div>
                            <div class="progress-bar progress-bar-danger" role="progressbar" style="width:{{item.PhanTramTimeRed}}%">
                                
                            </div>                                                      
                        </div>
                    </td>
                    <td></td>
                    <td>
                        <div class="progress" style="background-color:black;position:relative">
                            <div class="progress-bar progress-bar-success progress-bar-striped" role="progressbar"
                                 aria-valuenow="40" aria-valuemin="0" aria-valuemax="100" style="width:{{item.PhanTramTimeGreen}}%">                              
                            </div>
                            <span style="color:white;position:absolute;left:50%"> {{item.PhanTramTimeGreen | number: 0}} %</span>
                        </div>
                    </td>
                </tr>
            </tbody>           
        </table>
    </div>

