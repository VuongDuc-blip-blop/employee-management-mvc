
@{
    ViewBag.Title = "Index";
}
<link href="~/Content/css/HomeCSS.css" rel="stylesheet" />
<h1 class="start-screen-title text-center" style="font-weight: 800; color: deepskyblue">SETUP</h1>
<div class="container-fluid" style="margin-top: 33px !important;">
    <div class="row">
        <div class="col-md-3 col-sm-4">
            <div class="wrimagecard wrimagecard-topimage">
                <a href="/Setup/QuantityTarget">
                    <div class="wrimagecard-topimage_header" style="background-color:  rgba(51, 105, 232, 0.1)">
                        <center><i class="fas fa-chart-line" style="color:#3369e8"> </i></center>
                    </div>
                    <div class="wrimagecard-topimage_title">
