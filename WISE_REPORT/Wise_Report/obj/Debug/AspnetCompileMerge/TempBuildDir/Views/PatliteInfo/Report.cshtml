                                <td style="width:9em"><p style="width:9em;white-space:nowrap;overflow:hidden">{{item.TIME_OFF}}</p></td>
                                <td style="width:9em"><p style="width:9em;white-space:nowrap;overflow:hidden">{{item.UPTIME | currency: '' : 2}}</p></td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="col-md-12">
                        <button class="btn" ng-click="tableToExcel('Report_Monthly','MONTHLY_')">Export Excel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="QueryMonthlyModal" role="dialog" tabindex="-1">
        <div class="modal-dialog modal-lg" style="width:30%;">
            <div class="modal-content" style="min-height: 180px;">
                <div class="modal-header" style="border-bottom:none !important">
                    <button type="button" class="fa fa-times" style="float:right" data-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <table class="table">
                            <tr>
                                <th>Năm</th>
                                <td>
                                    <select class="form-control" ng-model="nam" data-ng-options="item as item for item in ListNam"></select>
                                </td>
                            </tr>
                            <tr>
                                <th>Tháng</th>
                                <td>
                                    <table class="table">
                                        <tr ng-repeat="item in ListMonth">
                                            <td>
                                                <input type="checkbox" ng-model="item.check" />
                                            </td>
                                            <td>
                                                Tháng {{item.month}}
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:none !important">
                    <div class="col-md-12">
                        <button class="btn" ng-click="QueryMonthly()">Lấy dữ liệu</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

