                                    <script>
                                        $("#tungay_Weekly").datepicker(
                                            {
                                                dateFormat: 'dd/mm/yy',
                                                beforeShowDay: function (date) {
                                                    var day = date.getDay();
                                                    var d = new Date(date)
                                                    d.setHours(0, 0, 0, 0)
                                                    var today = new Date()
                                                    today.setHours(0, 0, 0, 0)
                                                    return [(day == 1 && d <= today)];
                                                }
                                            }
