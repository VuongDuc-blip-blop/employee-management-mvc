                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="wrimagecard wrimagecard-topimage" ng-click="OpenDay()">
                        <div style="background-image: url('../../Content/images/ICON_Report_Daily.png');background-size:cover;height:188px;width:188px"></div>
                    </div>
                </div>
