<div ng-app="myApp" ng-controller="LiveBoardCtrl" class="col-md-12 no-padding">
    <div class="row">
        <div class="col-md-12">
            <div class="header-navbar" style="display:flex;justify-content:space-between;background: #222d32;">
                <header class="navbar-custom-menu " style="text-align:center;color:white;display:flex;flex:1;margin-left:15px;align-items:center">
                    <h3 style="margin:0;line-height:70px;text-transform:uppercase">TIME BOARD</h3>
                    <p ng-class="pause ? 'btn-pause' : 'btn-play'" ng-click="ChangeAuto()"></p>
                    <p ng-repeat="item in ListTrang" ng-class="item == sotrang ? 'btn-page-focus' : 'btn-page' " ng-click="ChuyenTrang(item)"></p>
                </header>
                <div class="main-header" style="display:inline-block">
                    Logo
                    <a href="/Home/HomeLayout" class="logo" style="background-color:#222d32">
                        <span class="logo-mini" style="transform: translateY(10px);">
                            <img src="/Content/images/logo_hoplong.png" height="60" width="100" style="vertical-align:middle" />
                        </span>
                        <span class="logo-lg" style="transform: translateY(10px);">
                            <img src="/Content/images/logo_hoplong.png" height="60" width="100" style="position:relative;top:10px" />
                        </span>
                    </a>
                </div>

                <div class="date-time" style="line-height:70px">
                    <span id="dotter" style="margin-right:5px;top:5px;position:relative"><i class="fa fa-circle" style="color:red;font-size:25px"></i></span>
                    <span id="date"></span> &nbsp;
                    <span id='time'></span>
                    <script>
                        window.onload = setInterval(clock, 1000);
                        function clock() {
                            var d = new Date();

                            var date = d.getDate();

                            var month = d.getMonth();
                            var montharr = ["Jan", "Feb", "Mar", "April", "May", "June", "July", "Aug", "Sep", "Oct", "Nov", "Dec"];
                            month = montharr[month];

                            var year = d.getFullYear();

                            var day = d.getDay();
                            var dayarr = ["Sun", "Mon", "Tues", "Wed", "Thurs", "Fri", "Sat"];
                            day = dayarr[day];

                            var hour = d.getHours();
                            var min = d.getMinutes();
                            var sec = d.getSeconds()

                            hour = (hour < 10) ? "0" + hour : hour;
                            min = (min < 10) ? "0" + min : min;
                            sec = (sec < 10) ? "0" + sec : sec;
                            document.getElementById("date").innerHTML = day + " " + date + " " + month + " " + year;
                            document.getElementById("time").innerHTML = hour + ":" + min + ":" + sec;
                        }
                        $(document).ready(function () {
                            var dotterFlicker = document.getElementById('dotter');
                            setInterval(function () {
                                dotterFlicker.style.display = (dotterFlicker.style.display == 'none' ? '' : 'none');
                            }, 1000);

                        });
                    </script>
                </div>
                <div class="back-homepage" style="margin:0 15px;line-height:70px">
                    <a href="/Home/HomeLayout"><i class="fa fa-th-list" style="color:#fff;font-size:22px;top:4px;position:relative"></i></a>
                </div>

            </div>
        </div>
    </div>
    <div class="form-timeboard">
        <div id="form" style="width:100%;height:100%;display:flex;">
            <div ng-repeat="data in DanhSachMay" class="machine-box__content boxdata page_1" style="width: 19.32%;margin-right:10px" ng-if="data.ListData[0] != null">
                <div id="Box{{data.MCID}}" style="width:100%">
                    <div>
                        <div class="sub_2  font-machine--white" ng-class="{'yellow' : data.ListData[0].CURRENT_STATE == 20, 'green' : data.ListData[0].CURRENT_STATE == 10, 'red' : data.ListData[0].CURRENT_STATE == 30, 'OFF' : data.ListData[0].CURRENT_STATE == 0, 'BLUE' : data.ListData[0].CURRENT_STATE == 40, 'ORANGE' : data.ListData[0].CURRENT_STATE == 50}" style="top: 8.97222px;width: 100%;height: 52.0389px;line-height: 52.0389px;">{{data.ListData[0].WDT_USERNAME}}</div>
                        <div class="sub_3  font-timechangestate--white" ng-class="{'yellow' : data.ListData[0].CURRENT_STATE == 20, 'green' : data.ListData[0].CURRENT_STATE == 10, 'red' : data.ListData[0].CURRENT_STATE == 30, 'OFF' : data.ListData[0].CURRENT_STATE == 0, 'BLUE' : data.ListData[0].CURRENT_STATE == 40, 'ORANGE' : data.ListData[0].CURRENT_STATE == 50}" style="top: 55.6278px;width: 100%;height: 53.8333px;line-height: 53.8333px;">{{data.ListData[0].RUNNING_TIME | secondtotime}}</div>
                        <div class="sub_4  uptime-status-circle__content" ng-class="{'uptime-bar--red' : data.ListData[0].uptime < data.ListData[0].PERCENT_TARGET, 'uptime-bar--green' : data.ListData[0].uptime >= data.ListData[0].PERCENT_TARGET}" style="margin:0 auto;margin-top:20px;margin-bottom:20px">
                            <span ng-show="data.ListData[0].uptime < data.ListData[0].PERCENT_TARGET">BAD</span>
                            <span ng-show="data.ListData[0].uptime >= data.ListData[0].PERCENT_TARGET">GOOD</span>
                        </div>
                        <div class="test" style="position:relative">
                            <div class="sub_5  uptimepercent--bg__content" style="top: 358.889px; width: 90%; height: 30px; line-height: 30px;margin:0 auto;">
                                <div id="baruptime1" style="width: {{data.ListData[0].uptime | currency : '' : 2}}%;" ng-class="{'uptime-bar--red' : data.ListData[0].uptime < data.ListData[0].PERCENT_TARGET, 'uptime-bar--green' : data.ListData[0].uptime >= data.ListData[0].PERCENT_TARGET}"></div>
                            </div>
                            <div class="sub_6  font-uptime-percent--white" style="top: 0; width: 90%; height: 30.5056px; line-height: 30.5056px;position:absolute">{{data.ListData[0].uptime | currency : '' : 2}}%</div>
                        </div>

                        <div class="sub_7  font-info--grey" style="">Up-Time</div>
                        <div class="sub_8  font-timecount--white" style="">{{data.ListData[0].TIME_GREEN | secondtotime}}</div>
                        <div class="sub_9  font-info--grey" style="">Down-time</div>
                        <div class="sub_10  font-timecount--white" style="">{{data.ListData[0].TIME_LOSS | secondtotime}}</div>
                    </div>

                    <div ng-show="data.ListPastData.length > 0" class="sub_11  font-lastfived--grey font-center--text" style="margin-bottom:10px">Last 5 days</div>

                    <div ng-show="data.ListPastData.length > 0" ng-repeat="item in data.ListPastData" style="margin-bottom:15px">
                        <div class="sub_12  lastfiveday__panel" style="width: 94%;height: 35px;line-height: 35px">
                            <div class="lastfived_sub_1  font-info--grey font-info--grey" style="width: 20%;height: 27.8139px;line-height: 27.8139px;">{{item.TEN_NGAY}}</div>
                            <div class="lastfived_sub_2  font-timelastfived--white" style="width: 40%;height: 27.8139px;line-height: 27.8139px;">{{item.TIME_GREEN | secondtotime}}</div>
                            <div class="lastfived_sub_3  progressbar-lastfived__panel" style="width: 40%; height: 27.8139px; line-height: 27.8139px;">
                                <div class="progress">
                                    <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" style="width: {{item.uptime | currency : '' : 2}}% !important; background: #910000;"><span class="show">{{item.uptime | currency : '' : 2}}%</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div id="Box99" class="machine-box__content legends-panel__footer" value="" style=" left: 0%; width: 100%; position:fixed;bottom:0; background: transparent; z-index: 2;">
            <span style="background: #00C109;width: 15px; height: 15px; border-radius: 50%; margin: 0px 10px 0px 10px;"></span>
            <span style="width: 55px !important; color: #ffffff; line-height: 15px !important; font-size: 1.3vmin">RUN</span>
            <span style="background: #fce406;width: 15px; height: 15px; border-radius: 50%; margin: 0px 10px 0px 10px;"></span>
