            <span style="background: #EB1C24;width: 15px; height: 15px; border-radius: 50%; margin: 0px 10px 0px 10px;"></span>
            <span style="width: 55px !important; color: #ffffff; line-height: 15px !important; font-size: 1.3vmin">ERROR</span>
            <span style="background: #6d6e71;width: 15px; height: 15px; border-radius: 50%; margin: 0px 10px 0px 10px;"></span>
            <span style="width: 55px !important; color: #ffffff; line-height: 15px !important; font-size: 1.3vmin">OFF</span>
        </div>
    </div>
  
</div>