<style>
    /*g.highcharts-series.highcharts-series-0.highcharts-column-series.highcharts-tracker,g.highcharts-series.highcharts-series-1.highcharts-column-series.highcharts-tracker,g.highcharts-series.highcharts-series-2.highcharts-column-series.highcharts-tracker, g.highcharts-series.highcharts-series-3.highcharts-column-series.highcharts-tracker{
          transition-duration: 2s;
    }*/

    .wrimagecard {
        width: auto;
    }

    .wrimagecard-topimage_header {
        border-radius: 10px;
        background-color: #fff;
        padding: 10px;
    }

    .wrimagecard .fa {
        position: relative;
        font-size: 20px;
    }

    .wrimagecard .fas {
        position: relative;
        font-size: 20px;
    }

    .wrimagecard .far {
        position: relative;
        font-size: 20px;
    }

    .section-tab {
        display: none;
    }

    .back-homepage:hover .section-tab {
        display: grid;
        /* position the divs under the navigation links */
        position: absolute;
        top: 0;
        right: 15px;
        z-index: 99;
        background: rgba(60, 60, 60, .9);
    }

    .wrimagecard-topimage_header {
        height: 50px;
        padding: 0;
    }

    .wrimagecard-topimage_title p {
        line-height: 1.3;
    }

    .wrimagecard-topimage_title a {
        color: #fff;
    }
</style>
<style>
    .btn-fix {
        width: 48px;
        height: 48px;
        display: inline-block;
        /*font-weight: 700;*/
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.375rem 0rem;
        font-size: 1.5rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        cursor: pointer;
        margin-right: 5px;
    }

    .btn-dayselect {
        color: black;
        background-color: #686868;
    }

    .day-selected {
        color: black;
        background-color: white;
    }
</style>