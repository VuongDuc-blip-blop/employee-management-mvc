            </div>
        </div>
    </div>

    <div class="modal fade" id="SelectYear" role="dialog" tabindex="-1">
        <div class="modal-dialog modal-sm" style="display:flex;align-items:center;margin:0 auto;height:100%">
            <div class="modal-content" style="width:100%">
                <div class="modal-header">
                    <h3 style="display:inline">SELECT YEAR</h3>
                    <a style="float:right" data-dismiss="modal" aria-hidden="true"><i class="fa fa-close" style="font-size:20px;color:black"></i> </a>
                </div>
                <div class="modal-body">
                    <select ng-model="nam" ng-change="reloadcolumn()" style="width:100%">
                        <option ng-repeat="item in ListNamSelect" ng-value="{{item}}">{{item}}</option>
                    </select>
                </div>
            </div>

