                <div class="date-time" style="line-height:70px;position:relative;align-items:center">
                    <button class="btn btn-default" data-toggle="modal" data-target="#SelectDay" style="position:absolute;left:0;left:calc(50% - 80px)">Query</button>
                    <div class="datetime-header" style="display:flex">
                        <span id="dotter" style="margin-right:5px;top:5px;position:relative"><i class="fa fa-circle" style="color:red;font-size:25px"></i></span>
                        <span id="date"></span> &nbsp;
                        <span id='time'></span>
                    </div>
               
                    <script>
                        window.onload = setInterval(clock, 1000);
                        function clock() {
                            var d = new Date();

                            var date = d.getDate();

                            var month = d.getMonth();
                            var montharr = ["Jan", "Feb", "Mar", "April", "May", "June", "July", "Aug", "Sep", "Oct", "Nov", "Dec"];
                            month = montharr[month];

                            var year = d.getFullYear();

                            var day = d.getDay();
                            var dayarr = ["Sun", "Mon", "Tues", "Wed", "Thurs", "Fri", "Sat"];
                            day = dayarr[day];

                            var hour = d.getHours();
                            var min = d.getMinutes();
                            var sec = d.getSeconds()

                            hour = (hour < 10) ? "0" + hour : hour;
                            min = (min < 10) ? "0" + min : min;
                            sec = (sec < 10) ? "0" + sec : sec;
                            document.getElementById("date").innerHTML = day + " " + date + " " + month + " " + year;
                            document.getElementById("time").innerHTML = hour + ":" + min + ":" + sec;
                        }
                        $(document).ready(function () {
                            var dotterFlicker = document.getElementById('dotter');
                            setInterval(function () {
                                dotterFlicker.style.display = (dotterFlicker.style.display == 'none' ? '' : 'none');
                            }, 1000);

                        });
                    </script>
                </div>
