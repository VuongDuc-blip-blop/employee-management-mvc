<body ng-app="myApp">

    <div class="container-scroller" ng-controller="ProjectsCtrl">

        <h3>List học sinh</h3>
        <button class="btn btn-success" ng-click="OpenAdd()">Thêm</button>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên học sinh</th>
                        <th>Ngày sinh</th>
                        <th>Nơi ở</th>
                        <th>Lớp</th>

                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in listHocSinh">
                        <td>{{item.ID}}</td>
                        <td>{{item.tenhocsinh}}</td>
                        <td>{{item.Ngaysinh | date:'dd/MM/yyyy'}}</td>
                        <td>{{item.Noio}}</td>
                        <td>{{item.tenlop}}</td>
                        <td>
                            <button class="btn btn-warning"
                                    ng-click="OpenEdit(item)">
                                Sửa
                            </button>
                            <button class="btn btn-danger"
                                    ng-click="XoaHocSinh(item)">
                                Xóa
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <hr />

        <h4>Danh sách lớp</h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên lớp</th>
                    <th>Sĩ số</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="lop in listLopHoc">
                    <td>{{lop.idlh}}</td>
                    <td>{{lop.tenlop}}</td>
                    <td>{{lop.siso}}</td>
                    <td>
                        <button class="btn btn-info"
                                ng-click="GetHocSinhByLop(lop)">
                            Xem học sinh
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- ================= MODAL XEM HỌC SINH ================= -->
        <div class="modal fade" id="hocSinhModal">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h4 class="modal-title">
                            Danh sách học sinh lớp {{lopDangChon.tenlop}}
                        </h4>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>

                    <div class="modal-body">
                        <p class="text-danger">
                            <button class="btn btn-success" ng-click="OpenAdd()">Thêm</button>
                        </p>

                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>
                                        Avatar
                                    </th>
                                    <th>Tên</th>
                                    <th>Ngày sinh</th>
                                    <th>Nơi ở</th>
                                    <th> Hành động </th>
                                    <th> Ghi chú </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="hs in listHocSinhTheoLop">
                                    <td>{{hs.ID}}</td>
                                    <td>
                                        <img ng-if="hs.Avatar"
                                             ng-src="{{getAvatarUrl(hs.Avatar)}}"
                                             class="avatar-hs"
                                             onerror="this.src='/Content/images/no-avatar.png'">
                                    </td>


                                    <td>{{hs.tenhocsinh}}</td>
                                    <td>{{hs.Ngaysinh | date:'dd/MM/yyyy'}}</td>
                                    <td>{{hs.Noio}}</td>
                                    <td>
                                        <button class="btn btn-warning" ng-click="OpenEdit(hs)">
                                            Sửa
                                        </button>
                                        <button class="btn btn-danger"
                                                ng-click="XoaHocSinh(hs)">
                                            Xóa
                                        </button>
                                    </td>
                                    <td>
                                        <div ng-bind-html="hs.ghichu | unsafe"></div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

        <!-- ================= MODAL SỬA ================= -->
        <div class="modal fade" id="editHocSinhModal">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h4 class="modal-title">Sửa học sinh</h4>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <label>Avatar học sinh</label>
<textarea id="avtEditor"
          ck-editor
          ng-model="editHocSinh.Avatar">
</textarea>

                    </div>
                    <div class="modal-body">
                        <label>Tên học sinh</label>
                        <input class="form-control" ng-model="editHocSinh.tenhocsinh">
                    </div>
                    <div class="modal-body">
                        <label>Ngày sinh</label>
                        <input type="date" ng-model="editHocSinh.Ngaysinh">

                    </div>
                    <div class="modal-body">
                        <label>Nơi ở </label>
                        <input class="form-control" ng-model="editHocSinh.Noio">

                    </div>
                    <div class="modal-body">
                        <label>Nhận xét chi tiết</label>
                        <textarea ck-editor ng-model="editHocSinh.ghichu" id="ghichuEditor"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-default" data-dismiss="modal">Hủy</button>
                        <button class="btn btn-success" ng-click="SuaHocSinh(editHocSinh)">
                            Lưu
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <!-- ================= MODAL THÊM ================= -->
        <div class="modal fade" id="addHocSinhModal">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h4 class="modal-title">Thêm học sinh</h4>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>

                    <div class="modal-body">
                        <input class="form-control" placeholder="Tên"
                               ng-model="newHocSinh.tenhocsinh">
                        <br />
                        <input class="form-control" placeholder="Ngày sinh"
                               ng-model="newHocSinh.ngaysinh">
                        <br />
                        <input class="form-control" placeholder="Nơi ở"
                               ng-model="newHocSinh.noio">
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-default" data-dismiss="modal">Hủy</button>
                        <button class="btn btn-success" ng-click="ThemHocSinh()">
                            Thêm
                        </button>
                    </div>

                </div>
            </div>
        </div>

    </div>
</body>

