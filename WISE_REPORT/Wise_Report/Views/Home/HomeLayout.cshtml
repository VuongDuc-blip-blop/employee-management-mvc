<body>
    <div class="container-scroller" ng-controller="ProjectsCtrl" ng-app="myApp">
        <!-- partial:partials/_navbar.html -->
        <div>List user{{a}}</div>
        <button class="btn btn-success" data-toggle="modal" data-target="#adduser">Thêm</button>
        <div class="table table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Name</th>
                        <th>Pass</th>
                        <th>Tính năng</th>
                    </tr>
                    <tr>
                        <th></th>
                        <th><input class="form-control"  ng-model="tukhoa1" ng-change="GetListUser()" /></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    <tr ng-repeat="item in listUser">
                        <td>
                            {{item.ID}}
                        </td>
                        <td>
                            <div ng-show="sua == false">{{item.USERNAME}}</div>
                            <input class="form-control" ng-if="sua == true" ng-model="item.USERNAME" />
                        </td>
                        <td>
                            <div ng-show="sua == false">{{item.FULLNAME}}</div>
                            <input class="form-control" ng-show="sua == true" ng-model="item.FULLNAME" />

                        </td>
                        <td>
                            <div ng-show="sua == false">{{item.PASSWORD}}</div>
                            <input class="form-control" ng-show="sua == true" ng-model="item.PASSWORD" />
                        </td>
                        <td>
                            <button class="btn btn-warning" ng-click="sua = true"  ng-show="sua == false">Sửa</button>
                            <button class="btn btn-success" ng-show="sua == true" ng-click="UpdateUser(item)">Lưu</button>
                            <button class="btn btn-danger"  ng-show="sua == true" ng-click="sua = false" >Hủy</button>
                            <button class="btn btn-danger" ng-show="sua == false" ng-click="DeleteUser(item)">Xóa</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="modal fade" id="adduser" role="dialog">
            <div class="modal-dialog" style="max-width:80%">

                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title" style="width:100%">Add Users</h4>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>

                    </div>
                    <div class="modal-body">
                        <div class="my-2">
                            <label>user</label>
                            <input type="text" class="form-control" ng-model="newUser" placeholder="User" />
                        </div>
                        <div class="my-2">
                            <label>Name</label>
                            <input type="text" class="form-control" ng-model="newName" placeholder="Name" />
                        </div>
                        <div class="my-2">
                            <label>Password</label>
                            <input type="text" class="form-control" ng-model="newPassword" placeholder="Password" />
                        </div>

                         <button type="button" class="btn btn-success" ng-click="AddUser()" >Thêm</button>


                        <button type="button" class="btn btn-danger" data-dismiss="modal">&times;</button>
                    </div>
                </div>
            </div>
        </div>

</body>

