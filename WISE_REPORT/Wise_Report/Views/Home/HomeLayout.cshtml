                                                                    <button ng-click="adduserviewtarget='True'" type="button" class="btn btn-primary"><i class="fa fa-user-plus" style="margin-right:5px"></i>Add Viewer</button>
                                                                    <div ng-show="adduserviewtarget=='True'">

                                                                        <label>Đã chọn: </label> <div ng-repeat="item in array_user_view_target"><button type="button" style="border:none;border-radius:20px;padding:3px 10px;color:white;background-color:#32a224;font-size:12px">{{item.FULLNAME}} <i class="fa fa-times" aria-hidden="true" ng-click="del_select_user_view_target($index)"></i> </button></div>
                                                                        <div class="form-khachhang">
                                                                            <input type="text" autocomplete="off" ng-model="keyword" ng-change="Find_User(keyword)" ng-focus="showtable_UserTarget = true" ng-blur="showtable_UserTarget = false" ng-model-options="{debounce:700}" required>
                                                                            <div class="input-group-btn" style="position:absolute">
                                                                                <div class="dropdown-menu dropdown-menu-center borderRadius0 padding0" style="display: block;max-height: 400px;overflow:auto;position:relative" ng-show="showtable_UserTarget">
                                                                                    <div class="table-responsive">
                                                                                        <table class="table table-striped table-hover" st-table="KhachHangBGCollection" st-safe-src="arrayNewKH_BaoGiaFinded">
                                                                                            <thead class="bg-blue text-white">
                                                                                                <tr>
                                                                                                    <th>ID</th>
                                                                                                    <th>Mã nhân viên</th>
                                                                                                    <th>Tên nhân viên</th>
                                                                                                </tr>
                                                                                            </thead>
                                                                                            <tbody>
                                                                                                <tr style="cursor:pointer" ng-mousedown="Select_multi_user_target(user);" ng-repeat="user in list_user_find">
                                                                                                    <td>{{user.ID}}</td>
                                                                                                    <td>{{user.USERNAME}}</td>
                                                                                                    <td>{{user.FULLNAME}}</td>
                                                                                                </tr>
                                                                                            </tbody>
                                                                                        </table>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <button ng-click="Create_user_viewTarget()" class="btn btn-save" type="button"><i class="fa fa-save" style="margin-right:5px"></i>Lưu</button>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!--==================================================================================-->
                                    <!--=============================Comments target=====================================================-->
                                    <div class="col-md-12" style="margin-top:20px">
                                        <div class="card">
                                            <div class="card-body">
                                                <h4 class="card-title ">Comments target</h4>
                                                <div>
                                                    <textarea style="resize:vertical;width:100%" ng-model="chat_comment_target" rows="2"  ng-keypress="($event.keyCode == 13 && !$event.shiftKey) ? AddNewComment_Target(): null"></textarea>
                                                    
                                                </div>
                                                <div class="list-wrapper">
                                                    <ul class="d-flex flex-column-reverse todo-list todo-list-custom" ng-repeat="item in list_comment_target">
                                                        <li class="completed-list">
                                                            <div class="form-check">
                                                                <span><img src="~/Content/images/icon_avatar_default.png" width="30" height="30" /></span>

                                                                <span>
                                                                    <label>{{item.USER_CREATE_NAME}}</label><br />
                                                                    <p>{{item.DATE_CREATE | date : 'dd/MM/yyyy'}}</p><br />
                                                                    <p style="margin-bottom:0; box-shadow: 0 3px 6px rgba(0,0,0,0.16), 0 3px 6px rgba(0,0,0,0.23);"><span style="padding:5px;display:block">{{item.COMMENT1}}</span></p>
</span>
                                                            </div>
                                                            <div class="button-delete" style="width:100%;text-align:right">
                                                                <i type="button" class="fa fa-trash" style="color:red;margin-right:5px;font-weight:normal;font:normal normal normal 14px/1 FontAwesome" aria-hidden="true" ng-click="RemoveComment(item.ID)"><span style="margin-left:2px">Xóa</span></i>
                                                            </div>
                                                        </li>

                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!--==================================================================================-->
                                </div>
                          
                        </div>
                    </div>
                </div>
                <!--End Modal detail target-->


            </div><!-- page-body-wrapper ends -->
        </div>
    </div>

</body>

