<body>
    <div class="container-scroller" ng-controller="ProjectsCtrl" ng-app="myApp">
        <!-- partial:partials/_navbar.html -->
        <!-- partial -->
        <div class="container-fluid page-body-wrapper" style="padding-top:0">
            <div class="content-wrapper" style="background-color:#0e4c6d !important">
                <div class="page-header">
                    <h3 class="font-weight-light text-white">Projects Board</h3>
                    <div style="display:inline-block">
                        <button class="btn btn-default ribbon  ribbon--orange" style="margin:0 10px;" data-toggle="modal" data-target="#Modal_View_Subordinate" ng-click="View_User_Subordinate(''); xemcapduoi=true"><span style="color:white">Xem cấp dưới</span></button>
                        @*<button class="btn btn-default" style="background-color: #fff !important" ng-click="View_User_Subordinate(); xemcapduoi=true" ng-hide="xemcapduoi">Xem cấp dưới</button>*@
                        <button class="btn btn-default ribbon  ribbon--orange" style="" ng-click="Show_self(); xemcapduoi=false" ng-show="xemcapduoi"><span style="color:white">Xem dữ liệu của tôi</span></button>
                        <br />


                    </div>

                    <div class="form-choose-status" style="display:flex">
                        <form class="panel panel-default panel-body " style="margin-bottom:0">
                            <label class="checkbox-radio">
                                <input type="radio" ng-click="LoadListProject()" name="complete"> View All
                            </label>
                            
                        </form>
                        <form class="panel panel-default panel-body checkbox-radio" style="margin-bottom:0;margin-left:20px">
                            <label class="checkbox-radio">
                                <input type="radio" ng-click="GetComplete(false);Filter_Data()" name="complete"> InComplete
                            </label>
                            <label>
                                <input type="radio" ng-click="GetComplete(true);Filter_Data()" name="complete"> Complete
                            </label>
                          

                        </form>
                        <form class="panel panel-default panel-body checkbox-radio" style="margin-bottom:0;margin-left:20px">
                            <label class="checkbox-radio">
                                <input type="radio" ng-click="GetStatus('assigned');Filter_Data()" name="status"> Assigned
                            </label>
                              
                            <label class="checkbox-radio">
                                <input type="radio" ng-click="GetStatus('assign'); Filter_Data()" name="status"> Assign
                            </label>
                            
                            <label class="checkbox-radio">
                                <input type="radio" ng-click="GetStatus('checker'); Filter_Data()" name="status"> Checker
                            </label>
                            
                            <label class="checkbox-radio">
                                <input type="radio" ng-click="GetStatus('follow'); Filter_Data()" name="status"> Follow
                            </label>
                               

                        </form>
                    </div>


                </div>
                <div class="row">
                    <div class="container-fluid pt-3">
                        <div class="row flex-row flex-sm-nowrap py-3">
                            <!--All Projects-->
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">

                                        <table style="width:100%">
                                            <tr>
                                                <td>
                                                    <div class="form-header">
                                                        <h6 class="card-title text-uppercase text-truncate py-2">Projects</h6>
                                                        <button class="btn btn-gradient-primary" data-toggle="modal" data-target="#Modal_create_project"><i class="fa fa-plus" style="margin-right:5px"></i>New project</button>
                                                    </div>

                                                </td>
                                                <td></td>
                                            </tr>
                                        </table>

                                        <div class="items border border-light" ng-repeat="item in ListProjectNone = (list_projects | filter:{PROJECT_NAME:searchFish}) " ng-click="projectid=item.ID; View_target_by_project(item.ID);Get_detail_project(item.ID); Get_user_view_project(item.ID);Get_All_Comment_Project(item.ID);LoadTaskDefault(item.ID)">
                                            <div class="card draggable shadow-sm">
                                                <div class="card-body p-2" ng-class="{'work-done' : item.PERCENT_DONE == 100, 'work-overdue' : item.IS_OVERDUE == true}">
                                                    <div class="card-title">
                                                        <div class="form-header-content">
                                                            <a class="lead font-weight-light" style="font-weight:bold !important; color:cornflowerblue;cursor:pointer;">{{item.PROJECT_NAME}}</a>
                                                            <div class="progress-bar bg-gradient-success" style="width:{{item.PERCENT_DONE}}%;position:relative; border:1px;float:none;height:25px;" role="progressbar" aria-valuenow="{{item.PERCENT_DONE}}" aria-valuemin="0" aria-valuemax="100"><em>{{item.PERCENT_DONE}}%</em></div>
                                                            <icon class="fa fa-trash" style="color:red; position:relative;text-align:right" ng-click="DeleteProject(item.ID)"></icon>
                                                        </div>
                                                    </div>
                                                    <p style="font-size:12px">
                                                        {{item.PROJECT_TARGERT}}
                                                    </p>
                                                    <div class="form-view-detail" style="display:grid;grid-template-columns:2fr 1fr;">
                                                        <div class="form-left-detail">
                                                            <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#modal-project-detail" style="background-color:cornflowerblue; border-color:cornflowerblue">View detail</button>
                                                            <span style="font-size:12px; color:cornflowerblue">Deadline: </span><span style="font-weight:bold; font-style:italic;font-size:11px; color:dimgray">{{item.DATE_END | date : 'dd/MM/yyyy'}}</span>
                                                        </div>

                                                        <div class="form-right-owner">
                                                            <span style="font-size:11px; color:cornflowerblue;line-height:30px">PIC: </span>
                                                            <img src="http://sales.hoplong.com/Content/Images/Avatar/{{item.PROJECT_OWNER_AVATAR}}" style="border-radius:50%" width="30" height="30">
                                                            <span style="font-weight:bold; font-size:11px; font-style:italic; color:dimgray;margin-left:5px">{{item.PROJECT_OWNER_NAME}}</span>
                                                           
                                                        </div>
                                                    </div>


                                                </div>
                                            </div>
                                            <div class="dropzone rounded"> &nbsp; </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--End all project-->
                            <!--All Targets-->
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <table style="width:100%">
                                            <tr>
                                                <td>
                                                    <div class="form-header">
                                                        <h6 class="card-title text-uppercase text-truncate py-2">Targets</h6>
                                                        <button class="btn btn-gradient-primary" data-toggle="modal" data-target="#Modal_create_target"><i class="fa fa-plus" style="margin-right:5px"></i>New target</button>
                                                    </div>

                                                </td>

                                            </tr>
                                        </table>

                                        <div class="panel panel-primary kanban-col" style="border-color:#337ab71f">
                                            <div class="panel-heading" style="background-color:#0e4c6d !important; border-color:white" ng-repeat-start="item in list_targets" ng-if="$first || item.PROJECT_NAME != list_targets[$index - 1].PROJECT_NAME">
                                                <h4>{{item.PROJECT_NAME}}</h4>
                                            </div>

                                            <div class="items border border-light" ng-repeat-end="item in list_targets" ng-dblclick="dbclick_open_target(item.ID)" ng-click="Get_Tasks_By_Target_ID(item.ID, item.TARGET_NAME);Get_All_Comment_Target(item.ID)">
                                                <div class="card draggable shadow-sm" id="cd1">
                                                    <div class="card-body p-2" ng-class="{'work-done' : item.PERCENT_DONE ==100, 'work-overdue' : item.IS_OVERDUE == true}">
                                                        <div class="card-title">
                                                            <div class="form-header-content">
                                                                <a class="lead font-weight-light" style="font-weight:bold !important; color:cornflowerblue;">{{item.TARGET_NAME}}</a>
                                                                <div class="progress-bar bg-gradient-danger" style="width:{{item.PERCENT_DONE}}%;position:relative; border:1px;float:none;height:25px;" role="progressbar" aria-valuenow="{{item.PERCENT_DONE}}" aria-valuemin="0" aria-valuemax="100"><em>{{item.PERCENT_DONE}}%</em></div>
                                                                <icon class="fa fa-trash" style="color:red; position:relative;text-align:right" ng-click="DeleteTarget(item.ID)"></icon>
                                                            </div>
                                                        </div>

                                                        <p>
                                                            <span style="font-size:12px" ng-bind-html="item.TARGET_DESCRIPTION | unsafe"></span>
                                                        </p>
                                                        <div class="form-view-detail" style="display:grid;grid-template-columns:1fr 2.2fr 5fr;">
                                                            <button class="btn btn-primary btn-sm" ng-click="View_detail_target(item.ID);Get_user_view_target(item.ID)" data-toggle="modal" data-target="#modal-target-detail" style="background-color:cornflowerblue; border-color:cornflowerblue">View detail</button>
                                                            <div class="form-left-detail" style="display:flex;align-items:center;justify-content:center">
                                                                <span style="font-size:12px; color:cornflowerblue">Deadline: </span>
                                                                <span style="font-weight:bold;font-size:11px; font-style:italic; color:dimgray">{{item.DATE_END | date : 'dd/MM/yyyy'}}</span>
                                                            </div>

                                                            <div class="form-right-owner" style="display:flex">
                                                                <span style="font-size:12px; color:cornflowerblue;line-height:30px">PIC: </span>
                                                                <img src="http://sales.hoplong.com/Content/Images/Avatar/{{item.USER_ASSIGNEE_AVATAR}}" style="border-radius:50%" width="30" height="30">
                                                                <span style="font-weight:bold;font-size:11px;font-style:italic;color:dimgray;margin-left:5px;display:flex;align-items:center">{{item.ASSIGNEE_NAME}}</span>
                                                                 &nbsp;&nbsp; 
                                                                <span style="font-size:12px; color:cornflowerblue;line-height:30px">Check: </span>
                                                                <img src="http://sales.hoplong.com/Content/Images/Avatar/{{item.USER_RECHECK_AVATAR}}" style="border-radius:50%" width="30" height="30">
                                                                <span style="font-weight:bold; font-size:11px; font-style:italic;margin-left:5px; color:dimgray;display:flex;align-items:center">{{item.RECHECK_USER_NAME}}</span>
                                                                
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="dropzone rounded"> &nbsp; </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--End All Targets-->


                            </div>
                            <!--All Tasks-->
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <table style="width:100%">
                                            <tr>
                                                <td>
                                                    <div class="form-header">
                                                        <h6 class="card-title text-uppercase text-truncate py-2">Tasks</h6>
                                                        <button class="btn btn-gradient-primary" data-toggle="modal" data-target="#Modal_create_task"><i class="fa fa-plus" style="margin-right:5px"></i>New task</button>
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>

                                        <div class="panel panel-primary kanban-col" style="border-color:#337ab71f">
                                            <div class="panel-heading" style="background-color:#0e4c6d !important;" ng-repeat-start="item in list_tasks" ng-if="$first || item.TARGET_NAME != list_tasks[$index - 1].TARGET_NAME">
                                                <h4>{{item.TARGET_NAME}}</h4> <span>{{item.PROJECT_NAME}}</span>
                                            </div>
                                            <div class="items border border-light" ng-repeat-end="item in list_tasks" ng-dblclick="dbclick_open_task(item.ID)">
                                                <div class="card draggable shadow-sm" id="cd9">
                                                    <div class="card-body p-2" ng-class="{'work-done' : item.IS_DONE == true, 'work-overdue' : item.IS_OVERDUE == true}">
                                                        <div class="card-title">
                                                            <div class="form-header-content" style="grid-template-columns:6fr 1fr">
                                                                <a class="lead font-weight-light" style="font-weight:bold !important; color:cornflowerblue;">{{item.TASK_NAME}}</a>
                                                                <i class="fa fa-trash" style="color:red; position:relative;text-align:right" ng-click="DeleteTask(item.ID)"></i>
                                                            </div>

                                                        </div>
                                                        <p style="font-size:12px">{{item.TASK_DESCRIPTIOM}}</p>

                                                        <div class="form-view-detail" style="display:grid;grid-template-columns:1fr 2fr;">
                                                            <div class="form-left-detail" style="display:flex;align-items:center">
                                                                <span style="font-size:12px; color:cornflowerblue">Deadline: </span><span style="font-weight:bold; font-size:11px; font-style:italic; color:dimgray">{{item.DATE_END | date : 'dd/MM/yyyy'}}</span>
                                                            </div>

                                                            <div class="form-right-owner" style="display:flex">
                                                                <span style="font-size:11px; color:cornflowerblue;line-height:30px">Todo: </span>
                                                                <img src="http://sales.hoplong.com/Content/Images/Avatar/{{item.USER_ASSIGNEE_AVATAR}}" style="border-radius:50%" width="30" height="30">
                                                                <span style="font-weight:bold; font-size:11px; font-style:italic; color:dimgray;;margin-left:5px;display:flex;align-items:center">{{item.ASSIGNEE_NAME}}</span>
                                                               &nbsp;&nbsp; <span style="font-size:11px; color:cornflowerblue;line-height:30px">Check: </span>
                                                                <img src="http://sales.hoplong.com/Content/Images/Avatar/{{item.USER_RECHECK_AVATAR}}" style="border-radius:50%" width="30" height="30">
                                                                <span style="font-weight:bold; font-size:11px; font-style:italic; color:dimgray;margin-left:5px;display:flex;align-items:center">{{item.RECHECK_USER_NAME}}</span>
                                                              
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--End All Tasks-->
                        </div>

                        @*<div class="title-project input-form-search" style="display:flex;justify-content:space-between">

                                <h4 class="card-title">All projects</h4>
                                <div class="search-name" style="position:relative;">
                                    <span class="fa fa-search form-control-feedback"></span>
                                    <input type="text" class="form-control" id="myInput" ng-model="searchFish" placeholder="Search for names.." autocomplete="off">
                                </div>
                            </div>*@

                    </div>
                </div>


