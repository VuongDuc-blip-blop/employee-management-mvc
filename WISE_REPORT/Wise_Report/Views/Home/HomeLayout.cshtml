                <!--MODAL VIEW SUBORDINATE-->
                <div class="modal fade" id="Modal_View_Subordinate" role="dialog">
                    <div class="modal-dialog" style="max-width:30%">


                        <!-- Modal content-->
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="container">
                                    <h2>Danh sách nhân viên của bạn</h2>
                                    <ul class="list-group" ng-repeat-start="item in Subordinate" ng-if="$first || item.GROUP_NAME != Subordinate[$index - 1].GROUP_NAME">
                                        <li class="list-group-item" style="background-color:steelblue; font-weight:bold; color:white">{{item.GROUP_NAME}}</li>
                                    </ul>
                                    <ul class="list-group" ng-repeat-end="item in list_targets">
                                        <li class="list-group-item" ng-click="Show_subordinate(item.ID)">
                                            <img src="http://sales.hoplong.com/Content/Images/Avatar/{{item.AVATAR}}" style="border-radius:50%" width="40" height="40">
                                            <span ng-style="item.IS_LEADER == true ? {'color':'steelblue'} : ''">{{item.FULLNAME}}</span>
                                        </li>
                                        
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--END VIEW SUBORDINATE-->

                <!--MODAL CREATE TARGET-->
                <div class="modal fade" id="Modal_create_target" role="dialog">
                    <div class="modal-dialog" style="max-width:80%">

                        <!-- Modal content-->
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title" style="width:100%">Add Targets</h4>
                                <button type="button" class="close" data-dismiss="modal">&times;</button>

                            </div>
                            <div class="modal-body">
                                <div class="col-md-7">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="title-project" style="display:flex;justify-content:space-between">
                                                <h4 class="card-title">Content Target</h4>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="row">
                                                    <form class="form-horizontal">
                                                        <div class="col-md-12">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3" style="text-align:left">Tên mục tiêu<span style="color:orangered; font-weight:bold"> (*)</span></label>
                                                                <div class="col-md-9">
                                                                    <input class="form-control" ng-model="TARGET_NAME" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3" style="text-align:left">Mô tả chi tiết</label>
                                                                <div class="col-md-9">
                                                                    @*<textarea style="resize:vertical;width:100%" rows="3" ng-model="TARGET_DESCRIPTION" class="form-control" placeholder="Nhập nội dung.."></textarea>*@
                                                                    <textarea name="TARGET_DESCRIPTION" id="TARGET_DESCRIPTION" class="form-control" ng-model="TARGET_DESCRIPTION"></textarea>
                                                                    <script>
                                                                        CKEDITOR.replace('TARGET_DESCRIPTION', {
                                                                            //extraPlugins: 'uploadimage,image2',
                                                                            height: 100,

                                                                            // Upload images to a CKFinder connector (note that the response type is set to JSON).
                                                                            uploadUrl: '/Content/download/plugins/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Files&responseType=json',

                                                                            // Configure your file manager integration. This example uses CKFinder 3 for PHP.
                                                                            filebrowserBrowseUrl: '/Content/download/plugins/ckfinder/ckfinder.html',
                                                                            filebrowserImageBrowseUrl: '/Content/download/plugins/ckfinder/ckfinder.html?type=Images',
                                                                            filebrowserUploadUrl: '/Content/download/plugins/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Files',
                                                                            filebrowserImageUploadUrl: '/Content/download/plugins/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Images',

                                                                            // The following options are not necessary and are used here for presentation purposes only.
                                                                            // They configure the Styles drop-down list and widgets to use classes.

                                                                            stylesSet: [
                                                                                { name: 'Narrow image', type: 'widget', widget: 'image', attributes: { 'class': 'image-narrow' } },
                                                                                { name: 'Wide image', type: 'widget', widget: 'image', attributes: { 'class': 'image-wide' } }
                                                                            ],

                                                                            // Load the default contents.css file plus customizations for this sample.
                                                                            contentsCss: [CKEDITOR.basePath + 'contents.css', ''],

                                                                            // Configure the Enhanced Image plugin to use classes instead of styles and to disable the
                                                                            // resizer (because image size is controlled by widget styles or the image takes maximum
                                                                            // 100% of the editor width).
                                                                            image2_alignClasses: ['image-align-left', 'image-align-center', 'image-align-right'],
                                                                            image2_disableResizer: true
                                                                        });
                                                                    </script>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="title-project" style="display:flex;justify-content:space-between">
                                                <h4 class="card-title">Date</h4>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="row">
                                                    <div class="form-horizontal">
                                                        <div class="col-md-12">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-4">Start Date: </label>
                                                                <div class="col-md-8">
                                                                    <div class="form-detail">
                                                                        <input type="text" id="ngaybatdau" autocomplete="off" class="form-control datetimepicker">

                                                                        <div class="form-control-feedback">
                                                                            <i class="icon-calendar"></i>
                                                                        </div>
                                                                    </div>
                                                                    <script>
                                                                            $("#ngaybatdau").datetimepicker({ format: 'DD/MM/YYYY', useCurrent: true, });
                                                                    </script>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-4">End Date: </label>
                                                                <div class="col-md-8">
                                                                    <div class="form-detail">
                                                                        <input type="text" id="ngayketthuc" autocomplete="off" class="form-control datetimepicker">

                                                                        <div class="form-control-feedback">
                                                                            <i class="icon-calendar"></i>
                                                                        </div>
                                                                    </div>
                                                                    <script>
                                                                            $("#ngayketthuc").datetimepicker({ format: 'DD/MM/YYYY', useCurrent: true, });
                                                                    </script>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-body" style="margin-top:20px">
                                            <div class="title-project" style="display:flex;justify-content:space-between">
                                                <h4 class="card-title">Phòng ban</h4>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="row">
                                                    <form class="form-horizontal">
                                                        <div class="col-md-12">
                                                            <div class="row">
                                                                <div class="col-md-6">
                                                                    <div class="form-group">
                                                                        <label class="control-label col-md-4">Phòng ban<span style="color:orangered; font-weight:bold"> (*)</span></label>
