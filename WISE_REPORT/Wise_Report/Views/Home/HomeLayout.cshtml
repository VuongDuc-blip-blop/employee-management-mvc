</head>

<body ng-app="myApp">

    <div class="container-scroller" ng-controller="ProjectsCtrl">
        <div class="user-management-page">

            <!-- ================= PAGE HEADER ================= -->
            <div class="user-page-header clearfix">
                <div class="pull-left">
                    <h3 class="user-page-title">Danh sách người dùng</h3>
                    <p class="text-muted user-page-subtitle">
                        Quản lý thông tin và trạng thái người dùng
                    </p>
                </div>

                <div class="pull-right user-page-actions">
                    <button type="button"
                            class="btn btn-success"
                            ng-click="OpenAdd()">
                        <i class="fa fa-plus"></i>
                        Thêm
                    </button>

                    <div class="btn-group" role="group" aria-label="Excel export showcase">
                        <button type="button"
                                class="btn btn-info dropdown-toggle"
                                data-toggle="dropdown"
                                ng-disabled="exportBusy">
                            <i class="fa fa-file-excel-o"></i>
                            
                        </button>

                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                <a href="" ng-click="exportUsers('alasql-current')">
                                    1. AlaSQL/XLSXML — trang hiện tại
                                </a>
                            </li>
                            <li>
                                <a href="" ng-click="exportUsers('html-current')">
                                    2. Client HTML .xls — trang hiện tại
                                </a>
                            </li>
                            <li>
                                <a href="" ng-click="exportUsers('multisheet-current')">
                                    3. Multi-sheet MIME .xls — trang + bộ lọc
                                </a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li>
                                <a href="" ng-click="exportUsers('server-html-all')">
                                    4. Server HTML .xls — toàn bộ kết quả lọc
                                </a>
                            </li>
                            <li>
                                <a href="" ng-click="exportUsers('server-epplus-all')">
                                    5. EPPlus .xlsx
                                </a>
                            </li>
                        </ul>
                    </div>

                    <span class="text-muted export-status" ng-if="exportBusy">
                        <i class="fa fa-spinner fa-spin"></i>
                        Đang tạo file
                    </span>
                </div>
            </div>

            <div class="alert alert-danger user-alert" ng-if="exportError" ng-bind="exportError"></div>

            <!-- ================= SEARCH ================= -->
            <div class="user-search-box">
                <div class="row">
                    <div class="col-sm-8 col-md-6">
                        <label class="user-search-label">Tìm kiếm người dùng</label>

                        <div class="input-group">
                            <input type="text"
                                   class="form-control"
                                   ng-model="userQuery.SearchKeyword"
                                   ng-keyup="$event.keyCode === 13 && SearchUsers()"
                                   placeholder="Nhập tên người dùng..." />

                            <span class="input-group-btn">
                                <button type="button"
                                        class="btn btn-primary"
                                        ng-click="SearchUsers()">
                                    <i class="fa fa-search"></i>
                                    Tìm kiếm
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-danger user-alert" ng-if="userListError">
                {{userListError}}
            </div>

            <!-- ================= USER LIST ================= -->
            <div class="panel panel-default user-list-panel">
                <div class="panel-heading clearfix user-table-heading">
                    <div class="pull-left">
                        <strong class="panel-title-text">
                            Danh sách
                        </strong>

                        <span class="text-muted user-result-count">
                            {{userTotalData}} người dùng
                        </span>
                    </div>

                    <div class="pull-right user-table-toolbar">
                        <span class="text-muted user-current-page-note">
                            Áp dụng cho trang hiện tại
                        </span>

                        <div class="btn-group btn-group-sm user-table-mode-switch"
                            role="group"
                            aria-label="Chọn kiểu hiển thị bảng">

                            <button type="button"
                                    class="btn btn-sm user-table-mode-button"
                                    ng-class="{
                                        'btn-primary':
                                            userTableMode === 'standard',
                                        'btn-default':
                                            userTableMode !== 'standard'
                                    }"
                                    ng-click="SetUserTableMode('standard')"
                                    aria-pressed="{{userTableMode === 'standard'}}">
                                <i class="fa fa-table"></i>
                                Bảng chuẩn
                            </button>

                            <button type="button"
                                    class="btn btn-sm user-table-mode-button"
                                    ng-class="{
                                        'btn-primary':
                                            userTableMode === 'dynamic',
                                        'btn-default':
                                            userTableMode !== 'dynamic'
                                    }"
                                    ng-click="SetUserTableMode('dynamic')"
                                    aria-pressed="{{userTableMode === 'dynamic'}}">
                                <i class="fa fa-columns"></i>
                                Bảng động
                            </button>

                            <button type="button"
                                    class="btn btn-sm user-table-mode-button"
                                    ng-class="{
                                        'btn-primary':
                                            userTableMode === 'pivot',
                                        'btn-default':
                                            userTableMode !== 'pivot'
                                    }"
                                    ng-click="SetUserTableMode('pivot')"
                                    aria-pressed="{{userTableMode === 'pivot'}}">
                                <i class="fa fa-object-group"></i>
                                PIVOT
                            </button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive" ng-if="userTableMode === 'standard'">
                    <table class="table table-hover user-table">
                        <thead>
                            <tr>
                                <th>
                                    <button type="button"
                                            class="btn btn-link user-sort-button"
                                            ng-click="ToggleUserNameSort()">
                                        Tên người dùng
                                        <span class="user-sort-icon" ng-if="userQuery.SortDirection === 1">▲</span>
                                        <span class="user-sort-icon" ng-if="userQuery.SortDirection === 2">▼</span>
                                    </button>
                                </th>
                                <th>Ngày tạo</th>
                                <th>Trạng thái</th>
                                <th class="user-action-column">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr ng-repeat="item in listUser track by item.Id">
                                <td>
                                    <button type="button"
                                            class="btn btn-link user-detail-button"
                                            ng-click="OpenUserDetail(item)">
                                    <strong>{{item.UserName}}</strong>
                                    </button>
                                </td>
                                <td>{{item.CreatedAt | date:'dd/MM/yyyy'}}</td>
                                <td>
                                    <span class="user-status">
                                        {{GetStatusText(item.ModerationStatus)}}
                                    </span>
                                </td>
                                <td class="user-action-column">
                                    <button type="button"
                                            class="btn btn-warning btn-sm"
                                            ng-click="OpenEdit(item)">
                                        <i class="fa fa-pencil"></i>
                                        Sửa
                                    </button>

                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            ng-click="DeleteUser(item)">
                                        <i class="fa fa-trash"></i>
                                        Xóa
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="table-responsive" ng-if = "userTableMode === 'dynamic'">
                    <table class="table table-hover user-table user-dynamic-table">
                        <thead>
                            <tr>
                                <th ng-repeat="column in userDynamicColumns track by column.Key">
                                    <button type="button" 
                                            class="btn btn-link user-sort-button"
                                            ng-if="column.Key === 'UserName'"
                                            ng-click="ToggleUserNameSort()">
                                        {{column.Title}}
                                  

                                        <span class="user-sort-icon" ng-if="userQuery.SortDirection === 1">
                                            ▲
                                        </span>
                                        <span class="user-sort-icon" ng-if="userQuery.SortDirection === 2">
                                            ▼
                                        </span>
                                    </button>

                                    <span ng-if="column.Key !== 'UserName'" ng-bind="column.Title">
                                        
                                    </span>
                                </th>

                                <th class ="user-action-column">
                                    Thao tác
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr ng-repeat="item in listUser track by item.Id">
                                <td ng-repeat ="column in userDynamicColumns track by column.Key" ng-switch="column.Type">
                                    <button ng-switch-when="user"
                                            type="button"
                                            class="btn btn-link user-name-link"
                                            ng-click="OpenUserDetail(item)"
                                            ng-bind="item[column.Key]">

                                    </button>

                                    <span ng-switch-when="date">
                                        {{item[column.Key] | date:'dd/MM/yyyy'}}
                                    </span>

                                    <span ng-switch-when="status">
                                        {{GetStatusText(item[column.Key])}}
                                    </span>

                                    <span ng-switch-default>
                                        {{item[column.Key] === null || item[column.Key] === undefined || item[column.Key] === '' ? '-' : item[column.Key]}}
                                    </span>

                                </td>

                                <td class="user-action-column">
                                    <button type="button"
                                            class="btn btn-warning btn-sm"
                                            ng-click="OpenEdit(item)">
                                        <i class="fa fa-pencil"></i>
                                        Sửa
                                    </button>

                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            ng-click="DeleteUser(item)">
                                        <i class="fa fa-trash"></i>
                                        Xóa
                                    </button>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="table-responsive" ng-if="userTableMode ==='pivot'">
                    <table class="table table-hover user-table user-pivot-table">
                        <thead>
                            <tr>
                                <th>Tên người dùng</th>
                                <th>Ngày tạo</th>
                                <th>Trạng thái</th>
                                <th class="user-action-column">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat-start = "group in userPivotGroups track by group.Key" class="user-pivot-group-row">
                                <td colspan="4" >
                                    <strong class="user-pivot-group-title">
                                        {{GetStatusText(group.Status)}}
                                    </strong>

                                    <span class="user-pivot-group-count">
                                        ({{group.Items.length}} người dùng)
                                    </span>
                                </td>
                            </tr>

                            <tr ng-repeat="item in group.Items track by item.Id">
                                <td>
                                    <button type="button"
                                            class="btn btn-link user-detail-button"
                                            ng-click="OpenUserDetail(item)">
                                        <strong ng-bind="item.UserName"></strong>

                                    </button>

                                </td>
                                <td>
                                    {{item.CreatedAt | date:'dd/MM/yyyy'}}
                                </td>
                                <td>
                                    <span class="user-status">
                                        {{GetStatusText(item.ModerationStatus)}}
                                    </span>
                                </td>
                                <td class="user-action-column">
                                    <button type="button"
                                            class="btn btn-warning btn-sm"
                                            ng-click="OpenEdit(item)">
                                        <i class="fa fa-pencil"></i>
                                        Sửa
                                    </button>

                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            ng-click="DeleteUser(item)">
                                        <i class="fa fa-trash"></i>
                                        Xóa
                                    </button>
                                </td>
                            </tr>

                            <tr ng-repeat-end class="user-pivot-group-spacer" aria-hidden="true">
                                <td colspan="4"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="panel-footer clearfix user-pagination">
                    <div class="pull-left user-pagination-info">
                        <span class="user-page-size-wrap">
                            Hiển thị
                            <select class="form-control input-sm user-page-size-select"
                                    ng-model="userQuery.PageSize"
                                    ng-options="size as size for size in userPageSizeOptions"
                                    ng-change="OnUserPageSizeChange()"></select>
                            mục / trang
                        </span>
                        <span class="user-pagination-separator">•</span>
                        Tổng số: <strong>{{userTotalData}}</strong>
                        <span class="user-pagination-separator">•</span>
                        Trang <strong>{{userQuery.PageIndex}}</strong> / <strong>{{GetUserPageCount()}}</strong>
                    </div>

                    <div class="pull-right">
                        <button type="button"
                                class="btn btn-default btn-sm user-pagination-button"
                                ng-disabled="userQuery.PageIndex <= 1"
                                ng-click="PreviousUserPage()">
                            <i class="fa fa-angle-left"></i>
                            Trước
                        </button>

                        <button type="button"
                                class="btn btn-default btn-sm user-pagination-button"
                                ng-disabled="userQuery.PageIndex >= GetUserPageCount()"
                                ng-click="NextUserPage()">
                            Sau
                            <i class="fa fa-angle-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- ================= MODAL SỬA ================= -->
            <div class="modal fade" id="editUserModal">
                <div class="modal-dialog">
                    <div class="modal-content user-modal">

                        <form name="editUserForm"
                              ng-submit="UpdateUser(editUser, editUserForm)"
                              novalidate>
                            <div class="modal-header">
                                <button type="button"
                                        class="close"
                                        data-dismiss="modal"
                                        aria-label="Đóng">
                                    <span aria-hidden="true">&times;</span>
                                </button>

                                <h4 class="modal-title">
                                    Sửa người dùng
                                </h4>
                            </div>

                            <div class="modal-body">
                                <div class="alert alert-danger user-modal-alert" ng-if="editUserValidation.summary.length">
                                    <div ng-repeat="error in editUserValidation.summary track by $index" ng-bind="error"></div>
                                </div>

                                <div class="form-group" ng-class="{'has-error': (editUserForm.UserName.$touched || editUserForm.$submitted) && editUserForm.UserName.$invalid}">
                                    <label for="edit-user-username">Tên người dùng</label>
                                    <input id="edit-user-username"
                                           name="UserName"
                                           class="form-control"
                                           ng-model="editUser.UserName"
                                           maxlength="256"
                                           required>
                                     <div class="help-block validation-message"
                                         ng-if="(editUserForm.UserName.$touched || editUserForm.$submitted) && editUserForm.UserName.$error.required">
                                        Vui lòng nhập tên đăng nhập.
                                    </div>
                                    <div class="help-block validation-message"
                                         ng-if="(editUserForm.UserName.$touched || editUserForm.$submitted) && editUserForm.UserName.$error.maxlength">
                                        Tên đăng nhập không được vượt quá 256 ký tự.
                                    </div>
                                     <div class="help-block validation-message"
                                         ng-if="editUserValidation.UserName.length">
                                        <div ng-repeat="error in editUserValidation.UserName track by $index"
                                            ng-bind="error"></div>
                                     </div>
                                </div>

                                  <div class="form-group" ng-class="{'has-error': (editUserForm.Password.$touched || editUserForm.$submitted) && editUserForm.Password.$invalid}">
                                    <label for="edit-user-password">Mật khẩu</label>
                                    <input id="edit-user-password"
                                           name="Password"
                                           type="password"
                                           class="form-control"
                                           ng-model="editUser.Password"
                                           maxlength="128"
                                           required>
                                     <div class="help-block validation-message"
                                         ng-if="(editUserForm.Password.$touched || editUserForm.$submitted) && editUserForm.Password.$error.required">
                                        Vui lòng nhập mật khẩu mới.
                                    </div>
                                    <div class="help-block validation-message"
                                         ng-if="(editUserForm.Password.$touched || editUserForm.$submitted) && editUserForm.Password.$error.maxlength">
                                        Mật khẩu không được vượt quá 128 ký tự.
                                    </div>
                                     <div class="help-block validation-message"
                                         ng-if="editUserValidation.Password.length">
                                        <div ng-repeat="error in editUserValidation.Password track by $index"
                                            ng-bind="error"></div>
                                     </div>
                                </div>
                                <div class="form-group"
                                    ng-class="{
                                        'has-error':
                                            (editUserForm.ProfileDescription.$touched || editUserForm.$submitted)
                                            && editUserForm.ProfileDescription.$invalid
                                    }">

                                    <label for="edit-user-profile-description">
                                        Mô tả hồ sơ
                                    </label>

                                    <textarea id="edit-user-profile-description"
                                            name="ProfileDescription"
                                            class="form-control"
                                            ng-model="editUser.ProfileDescription"
                                            ng-maxlength="5000"
                                            ckeditor>
                                    </textarea>

                                    <div class="help-block validation-message"
                                        ng-if="
                                            (editUserForm.ProfileDescription.$touched || editUserForm.$submitted)
                                            && editUserForm.ProfileDescription.$error.maxlength
                                        ">
                                        Mô tả hồ sơ không được vượt quá 5000 ký tự.
                                    </div>

                                    <div class="help-block validation-message"
                                        ng-if="editUserValidation.ProfileDescription.length">

                                        <div ng-repeat="
                                                error in editUserValidation.ProfileDescription track by $index
                                            "
                                            ng-bind="error">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-default user-secondary-button"
                                        data-dismiss="modal">
                                    Hủy
                                </button>

                                <button type="submit"
                                        class="btn btn-success">
                                    <i class="fa fa-check"></i>
                                    Lưu
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <!-- ================= MODAL THÊM ================= -->
            <div class="modal fade" id="addUserModal">
                <div class="modal-dialog">
                    <div class="modal-content user-modal">

                        <form name="addUserForm"
                              ng-submit="AddUser(addUserForm)"
                              novalidate>
                            <div class="modal-header">
                                <button type="button"
                                        class="close"
                                        data-dismiss="modal"
                                        aria-label="Đóng">
                                    <span aria-hidden="true">&times;</span>
                                </button>

                                <h4 class="modal-title">
                                    Thêm người dùng
                                </h4>
                            </div>

                            <div class="modal-body">
                                <div class="alert alert-danger user-modal-alert" ng-if="addUserValidation.summary.length">
                                    <div ng-repeat="error in addUserValidation.summary track by $index" ng-bind="error"></div>
                                </div>

                                <div class="form-group" ng-class="{'has-error': (addUserForm.UserName.$touched || addUserForm.$submitted) && addUserForm.UserName.$invalid}">
                                    <label for="add-user-username">Tên người dùng</label>
                                    <input id="add-user-username"
                                           name="UserName"
                                           class="form-control"
                                           ng-model="newUser.UserName"
                                           maxlength="256"
                                           placeholder="Nhập tên người dùng"
                                           required>
                                     <div class="help-block validation-message"
                                         ng-if="(addUserForm.UserName.$touched || addUserForm.$submitted) && addUserForm.UserName.$error.required">
                                        Vui lòng nhập tên đăng nhập.
                                    </div>
                                    <div class="help-block validation-message"
                                         ng-if="(addUserForm.UserName.$touched || addUserForm.$submitted) && addUserForm.UserName.$error.maxlength">
                                        Tên đăng nhập không được vượt quá 256 ký tự.
                                    </div>
                                     <div class="help-block validation-message"
                                         ng-if="addUserValidation.UserName.length">
                                        <div ng-repeat="error in addUserValidation.UserName track by $index"
                                            ng-bind="error"></div>
                                     </div>
                                </div>

                                  <div class="form-group" ng-class="{'has-error': (addUserForm.Password.$touched || addUserForm.$submitted) && addUserForm.Password.$invalid}">
                                    <label for="add-user-password">Mật khẩu</label>
                                    <input id="add-user-password"
                                           name="Password"
                                           type="password"
                                           class="form-control"
                                           ng-model="newUser.Password"
                                           maxlength="128"
                                           placeholder="Nhập mật khẩu"
                                           required>
                                     <div class="help-block validation-message"
                                         ng-if="(addUserForm.Password.$touched || addUserForm.$submitted) && addUserForm.Password.$error.required">
                                        Vui lòng nhập mật khẩu.
                                    </div>
                                    <div class="help-block validation-message"
                                         ng-if="(addUserForm.Password.$touched || addUserForm.$submitted) && addUserForm.Password.$error.maxlength">
                                        Mật khẩu không được vượt quá 128 ký tự.
                                    </div>
                                     <div class="help-block validation-message"
                                         ng-if="addUserValidation.Password.length">
                                        <div ng-repeat="error in addUserValidation.Password track by $index"
                                            ng-bind="error"></div>
                                     </div>
                                </div>

                                <div class="form-group">
                                    <label>Trạng thái</label>
                                    <select class="form-control"
                                            ng-model="newUser.ModerationStatus">
                                        <option value="0">Pending</option>
                                        <option value="1">Approved</option>
                                        <option value="2">Rejected</option>
                                    </select>
                                </div>

                                <div class="form-group"
                                    ng-class="{
                                        'has-error':
                                            (addUserForm.ProfileDescription.$touched || addUserForm.$submitted)
                                            && addUserForm.ProfileDescription.$invalid
                                    }">

                                    <label for="add-user-profile-description">
                                        Mô tả hồ sơ
                                    </label>

                                    <textarea id="add-user-profile-description"
                                            name="ProfileDescription"
                                            class="form-control"
                                            ng-model="newUser.ProfileDescription"
                                            ng-maxlength="5000"
                                            ckeditor>
                                    </textarea>

                                    <div class="help-block validation-message"
                                        ng-if="
                                            (addUserForm.ProfileDescription.$touched || addUserForm.$submitted)
                                            && addUserForm.ProfileDescription.$error.maxlength
                                        ">
                                        Mô tả hồ sơ không được vượt quá 5000 ký tự.
                                    </div>

                                    <div class="help-block validation-message"
                                        ng-if="addUserValidation.ProfileDescription.length">

                                        <div ng-repeat="
                                                error in addUserValidation.ProfileDescription track by $index
                                            "
                                            ng-bind="error">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-default user-secondary-button"
                                        data-dismiss="modal">
                                    Hủy
                                </button>

                                <button type="submit"
                                        class="btn btn-success">
                                    <i class="fa fa-plus"></i>
                                    Thêm
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <!-- ================= MODAL CHI TIẾT ================= -->
            <div class="modal fade" id="userDetailModal">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content user-modal">

                        <div class="modal-header">
                            <button type="button"
                                    class="close"
                                    data-dismiss="modal"
                                    aria-label="Đóng">
                                <span aria-hidden="true">&times;</span>
                            </button>

                            <h4 class="modal-title">
                                Chi tiết người dùng
                            </h4>
                        </div>

                        <div class="modal-body">

                            <div class="text-center user-detail-loading"
                                ng-if="userDetailLoading">
                                <i class="fa fa-spinner fa-spin"></i>
                                Đang tải thông tin...
                            </div>

                            <div class="alert alert-danger"
                                ng-if="userDetailError"
                                ng-bind="userDetailError">
                            </div>

                            <div ng-if="!userDetailLoading && userDetail">

                                <div class="row user-detail-row">
                                    <div class="col-sm-3 user-detail-label">
                                        Tên người dùng
                                    </div>

                                    <div class="col-sm-9">
                                        <strong ng-bind="userDetail.UserName"></strong>
                                    </div>
                                </div>

                                <div class="row user-detail-row">
                                    <div class="col-sm-3 user-detail-label">
                                        Ngày tạo
                                    </div>

                                    <div class="col-sm-9">
                                        {{userDetail.CreatedAt | date:'dd/MM/yyyy'}}
                                    </div>
                                </div>

                                <div class="row user-detail-row">
                                    <div class="col-sm-3 user-detail-label">
                                        Trạng thái
                                    </div>

                                    <div class="col-sm-9">
                                        <span class="user-status">
                                            {{GetStatusText(userDetail.ModerationStatus)}}
                                        </span>
                                    </div>
                                </div>

                                <hr />

                                <div class="user-detail-profile">
                                    <div class="user-detail-profile-title">
                                        Mô tả hồ sơ
                                    </div>

                                    <div class="text-muted"
                                        ng-if="!userDetail.ProfileDescription">
                                        Chưa có mô tả hồ sơ.
                                    </div>

                                    <div class="ckeditor-content"
                                        ng-if="userDetail.ProfileDescription"
                                        ng-bind-html="userDetailProfileHtml">
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-default user-secondary-button"
                                    data-dismiss="modal">
                                Đóng
                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <!-- ================= MODAL XÁC NHẬN XÓA ================= -->
            <div class="modal fade" id="deleteUserModal">
                <div class="modal-dialog modal-sm">
                    <div class="modal-content user-modal user-delete-modal">
                        <div class="modal-header">
                            <button type="button"
                                    class="close"
                                    data-dismiss="modal"
                                    aria-label="Đóng">
                                <span aria-hidden="true">&times;</span>
                            </button>

                            <h4 class="modal-title">
                                Xác nhận xóa
                            </h4>
                        </div>

                        <div class="modal-body">
                            <div class="user-delete-summary">
                                <i class="fa fa-exclamation-triangle"></i>
                                <div>
                                    <p>Bạn có chắc muốn xóa người dùng này?</p>
                                    <strong ng-bind="pendingDeleteUser.UserName"></strong>
                                </div>
                            </div>

                            <div class="alert alert-danger user-modal-alert" ng-if="deleteUserError" ng-bind="deleteUserError"></div>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-default user-secondary-button"
                                    data-dismiss="modal">
                                Hủy
                            </button>

                            <button type="button"
                                    class="btn btn-danger"
                                    ng-click="ConfirmDeleteUser()"
                                    ng-disabled="deleteBusy">
                                <i class="fa fa-trash"></i>
                                <span ng-if="!deleteBusy">Xóa</span>
                                <span ng-if="deleteBusy"><i class="fa fa-spinner fa-spin"></i> Đang xóa</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</body>

