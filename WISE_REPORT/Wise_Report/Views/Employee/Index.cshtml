
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Wise Management</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/Content/vendor/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/Content/vendor/vendor.bundle.base.css">
    <link rel="stylesheet" href="~/Content/bower_components/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://rawgit.com/mervick/emojionearea/master/dist/emojionearea.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/css/jquery.emojipicker.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/jquery.emojipicker.tw.css">
    <link rel="stylesheet" href="~/Content/pnotify.custom.min.css" />
    <link href="~/Content/css/style.css" rel="stylesheet" />

    <script src="~/Content/dist/js/jquery.min.js"></script>
    <script src="~/Content/js-vendor/dashboard.js"></script>
    <script src="~/Content/js-vendor/misc.js"></script>
    <script src="~/Content/js-vendor/hoverable-collapse.js"></script>
    <script src="~/Content/bootstrap-datetimepicker.js"></script>
    <script type="text/javascript" src="~/Content/scripts/jquery.emojis.js"></script>
    <script type="text/javascript" src="~/Content/scripts/jquery.emojipicker.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/alasql/3.5.0/alasql.min.js"></script>
    <script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-sanitize.js"></script>


    <!-- endinject -->
