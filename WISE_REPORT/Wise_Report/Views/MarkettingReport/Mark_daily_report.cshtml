<body>
    <div class="container-scroller" ng-controller="Mark_daily_reportCtrl" ng-app="myApp">
        <input type="hidden" value="@Session["userid"]" id="currentuserid" name="currentuserid" />
        <div class="container-fluid page-body-wrapper">
            <div class="content-wrapper">
                <div class="col-md-12">
                    <div class="row">
                        <!--============================MODAL REPORT =========================================-->
                        <div class="change-tab" style="width:100%">

                            <ul class="tabs">
                                <li class="tab-link current" ng-click="deptid='';LoadReport();Load_Listdept();" data-tab="tab-1">General Report</li>
                                <li class="tab-link" ng-click="deptid=4;LoadReport();" data-tab="tab-2">Sale Report</li>
                                <li class="tab-link" ng-click="LoadWarrantyReport();LoadWarrantyChart();" data-tab="tab-3">Warranty Report</li>
                            </ul>

                            <!--============================TAB GENERAL REPORT =========================================-->
                            <div id="tab-1" class="tab-content">
                                <!--==============Show danh sách report============--->
                                <div class="col-md-6">
                                    <div class="col-md-5">
                                        <div class="input-form-search has-search" style="display:flex;width:100%">
                                            <div class="search-name" style="position:relative;width:100%;">
                                                <span class="fa fa-search form-control-feedback"></span>
                                                <input type="text" autocomplete="off" class="form-control" ng-model="tukhoa1" my-enter="LoadReport()" placeholder="Search for report names.." title="Type in a name">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4" style="border:none">
                                        <div class="col-md-2">
                                            <label>Phòng:</label>
                                        </div>
                                        <div class="col-md-10">
                                            <select ng-model="deptid" ng-change="LoadReport()" class="form-control">
                                                <option value=""></option>
                                                <option ng-repeat="item in list_depts" ng-value="{{item.ID}}">
                                                    {{ item.DEPARTMENT_NAME }}
                                                </option>
                                            </select>
                                        </div>

                                    </div>

                                    <div class="col-md-3">
                                        <div id="phan_trang_listrp" style="float:right;margin:0px;font-size:12px !important"></div>
                                    </div>

                                    <table cellspacing="0" class="table table-hover" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Report name</th>
                                                <th style="max-width:50px">Reporter</th>
                                                <th style="max-width:30px">Date create</th>
                                                <th style="max-width:20px">
                                                    <span>Checked</span>
                                                    <input type="checkbox" ng-model="status" ng-click="LoadReport()" />
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="item in list_report">
                                                <td ng-click="LoadListMarkDailyReport(item);LoadListReportComment(item.ID)">
                                                    <div class="content-textarea">
                                                        <span ng-dblclick="editColF=true" ng-hide="editColF">{{item.REPORT_NAME}}</span>
                                                        <input style="resize:vertical;" class="form-control" ng-model="item.REPORT_NAME" ng-dblclick="editColF=false" my-enter="Update_file_name(item);" ng-show="editColF"></input>
                                                    </div>
                                                </td>
                                                <td style="max-width:20px" ng-click="LoadListMarkDailyReport(item);LoadListUserViewReport(item.ID);" data-toggle="modal" data-target="#add_user_view">{{item.FULLNAME}}</td>
                                                <td style="max-width:20px" ng-click="LoadListMarkDailyReport(item);">{{item.CREATE_DATE | date: dd/MM/yyyy}}</td>
                                                @*<td ng-click="Update_file_name(item)">{{item.IS_CHECK}}</td>*@
                                                <td style="max-width:20px">
                                                    <div class="form-checkbox">
                                                        <input type="checkbox" ng-model="item.IS_CHECK" ng-click="Update_is_checked(item)" />
                                                        @*<input ng-show="Editgroupuser" type="checkbox" ng-model="item.IS_CHECK" />*@
                                                    </div>
                                                </td>
                                                @*<td><button type="button" style="border:none;max-width:20px" ng-click="addnewcmt = true">comment</button></td>*@
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <!--==============End Show danh sách report============--->
                                <div class="col-md-6">
                                    <div class="button-modal col-md-5">
                                        <button class="btn-info" data-toggle="modal" data-target="#add_new_report">Create report</button>
                                    </div>
                                    <button type="button" class="btn-info" ng-click="import=true; newtbl=true;" ng-hide="import">Import & create new report</button>
                                    <!--==============Show Comment report============--->
                                    <div class="col-md-12">
                                        <p style="white-space:pre-line;word-break:break-word;background-color:#fbf9e9" class="content-target" ng-bind-html="latest_report_comment.COMMENT | unsafe" ng-hide="edit_description"></p>
                                        <label style="font-size:9px; float:right;margin:0px;" ng-show="latest_report_comment.COMMENT!=null"><button data-toggle="modal" data-target="#all_report_cmt">see more</button></label>
                                        <label style="font-size:11px;font-weight: normal;float:right;margin:0px;" ng-show="latest_report_comment.COMMENT!=null">
                                            <img src="http://sales.hoplong.com/Content/Images/Avatar/{{latest_report_comment.AVATAR}}" width="30" height="30" style="border-radius:50%"> {{latest_report_comment.FULLNAME}}-{{latest_report_comment.CREATE_DATE | date: dd/MM/yyyy}}
                                        </label>
                                    </div>
                                    <div class="col-md-12">
                                        <hr />
                                        <label style="font-size:9px; float:left;margin:0px;" ng-show="latest_report_comment.COMMENT!=null"><button data-toggle="modal" data-target="#Add_report_cmt">Add comment</button></label>
                                    </div>
                                    <!--==============End Show Commnet report============--->
                                </div>


