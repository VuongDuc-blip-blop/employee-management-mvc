<body class="hold-transition skin-blue sidebar-mini sidebar-collapse" ng-app="myApp" ng-controller="NotificationCtrl" style="padding-right:0;">
    <div class="wrapper" style="background-color:#fff">
        <div class ="hidden" aria-hidden="true">@Html.AntiForgeryToken()</div>
        <input type="hidden" value="@Session["fullname"]" id="fullname" />
        <input type="hidden" value="@Session["username"]" id="username" />
        <input type="hidden" value="@Session["userid"]" id="userid" />

        <nav class="navbar default-layout-navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
                <a class="navbar-brand brand-logo" href="/Home/HomeLayout" style="height:70px;margin:0"><img src="~/Content/images/logo-pme.png" alt="logo" width="240" height="70" style="width:100%;height:70px"/> </a>
                <a class="navbar-brand brand-logo-mini" href="/Home/HomeLayout" style="margin:0;padding:0" ><img src="~/Content/images/logo-pme-small.png" style="height:50px;width:100%;padding:5px;height:50px" alt="logo" width="80" height="70"/> </a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-stretch">
                <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                    <span class="mdi mdi-menu"></span>
                </button>
                <div class="search-field d-none d-md-block">
                    <form class="d-flex align-items-center h-100" action="#">
                        <div class="input-group">
                            <div class="input-group-prepend bg-transparent">
                                <i class="input-group-text border-0 mdi mdi-magnify"></i>
                            </div>
                            <input type="text" class="form-control bg-transparent border-0" placeholder="Search projects">
                        </div>
                    </form>
                </div>
                <ul class="navbar-nav navbar-nav-right">
                    <li class="nav-item nav-profile dropdown">
                        <a class="nav-link dropdown-toggle" id="profileDropdown" href="#" data-toggle="dropdown" aria-expanded="false">
                            <div class="nav-profile-img">
                                @*<img src="assets/images/faces/face1.jpg" alt="image">*@
                                <span class="availability-status online"></span>
                            </div>
                            <div class="nav-profile-text">
                                <p class="mb-1 text-black">@Session["fullname"]</p>
                            </div>
                        </a>
                        <div class="dropdown-menu navbar-dropdown" aria-labelledby="profileDropdown" style="padding:12px 12px;min-width:auto">
                            <a class="dropdown-item" href="/Home/ChangePassword">
                                <i class="mdi mdi-cached mr-2 text-success"></i> Change Password
                            </a>
                            <div class="dropdown-divider"></div>
                             <div ng-controller="SessionIdentityCtrl as identity">
                                <button type="button"
                                        class="dropdown-item border-0 bg-transparent"
                                        ng-click="identity.logout()"
                                        ng-disabled="identity.busy">
                                    <i class="mdi mdi-logout mr-2 text-primary"></i> Sign out
                                </button>
                                <small class="text-danger" ng-if="identity.error" ng-bind="identity.error"></small>
                            </div>
                        </div>
                    </li>
                    <li class="nav-item d-none d-lg-block full-screen-link">
                        <a class="nav-link">
                            <i class="mdi mdi-fullscreen" id="fullscreen-button"></i>
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link count-indicator dropdown-toggle" id="notificationDropdown" href="#" data-toggle="dropdown">
                            <i class="mdi mdi-bell-outline" ng-click="LoadListNotification_NotRead();"></i>
                            <span class="count-symbol" style="background-color:#ff0033;color:white"><b style="top:-1px;display:block;width:16px;text-align:center;position:relative">{{tongso_unread}}</b></span>

                        </a>
                        <div class="dropdown-menu dropdown-menu-right navbar-dropdown preview-list" aria-labelledby="notificationDropdown">
                            <h5 class="p-3 mb-0">Notifications</h5>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item preview-item" style="max-height:375px;overflow-y:scroll">

                                <div class="preview-item-content d-flex align-items-start flex-column justify-content-center">
                                    <table class="preview-subject font-weight-normal" style="max-height:400px">
                                        <thead></thead>
                                        <tbody>
                                            <tr ng-repeat="item in listNotification" ng-click="openlink(item.LINK)" >
                                                <td ng-click="ChangeStatusIsRead(item)" style="margin-bottom:10px">
                                                    <div class="preview-thumbnail" ng-style="!item.IS_READ && {'background-color':'rgb(220, 231, 251)'}">
                                                        <div class="preview-icon bg-success" style="float:left;margin-right:10px">
                                                            <i class="mdi mdi-calendar"></i>
                                                        </div>
                                                        <p class="list-comment" style="white-space:normal;word-break:break-word;color:#000;margin:0;line-height:1.3;display:table-cell">{{item.COMMENT}}</p>
                                                    </div>

                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </a>

                            <div class="dropdown-divider"></div>
                            <h5 style="cursor:pointer;color:red" class="p-3 mb-0 text-center" ng-click="openlink('/Notification/Notifications')">See all notifications</h5>
                        </div>
                    </li>
                     <li class="nav-item nav-logout d-none d-lg-block">
                         <div ng-controller="SessionIdentityCtrl as identity">
                            <button type="button"
                                    class="nav-link border-0 bg-transparent"
                                    aria-label="Sign out"
                                    ng-click="identity.logout()"
                                    ng-disabled="identity.busy">
                                <i class="mdi mdi-power"></i>
                            </button>
                        </div>
                    </li>
                    <li class="nav-item nav-settings d-none d-lg-block">
                        <a class="nav-link" href="#">
                            <i class="mdi mdi-format-line-spacing"></i>
                        </a>
                    </li>
                </ul>
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                    <span class="mdi mdi-menu"></span>
                </button>
            </div>
        </nav>
        <!-- Content Wrapper. Contains page content -->


        <div class="page-body-wrapper">
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">

                    @Html.Partial("_ManagementNavigationItems")
                </ul>
            </nav>
            <div class="content-wrapper main-panel" style="background-color:0e4c6d !important">
                <!-- Content Header (Page header) -->
                <!-- Main content -->
                <section class="">
                    @RenderBody()
                </section>
                <!-- /.content -->
            </div>
        </div>

    </div>

    <style>
        .preview-item::-webkit-scrollbar {
            background: #fff;
            width: 4px;
        }

        .preview-item::-webkit-scrollbar-thumb {
            background: #c5c5c5;
        }
        body {
    margin: 0;
    font-family: sans-serif;
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.5;
    color: #495057;
    text-align: left;
}

    </style>
</body>

</html>
