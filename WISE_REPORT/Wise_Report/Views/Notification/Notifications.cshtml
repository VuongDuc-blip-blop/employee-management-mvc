    <link href="~/Content/css/style.css" rel="stylesheet" />
    <script src="~/Content/dist/js/jquery.min.js"></script>
    @*<script src="~/Content/js-vendor/vendor.bundle.base.js"></script>*@
    <script src="~/Content/js-vendor/dashboard.js"></script>
    <script src="~/Content/js-vendor/misc.js"></script>
    <script src="~/Content/js-vendor/hoverable-collapse.js"></script>
    <script src="~/Content/bootstrap-datetimepicker.js"></script>
